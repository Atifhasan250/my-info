# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_here

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# SEO & Search Engine Verification (Add these in Vercel to verify domain ownership)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here
NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_site_verification_code_here
